BasedOnStyle: LLVM
Language: Cpp

# Indentation
UseTab: Never
IndentWidth: 4
TabWidth: 4
ContinuationIndentWidth: 4
ColumnLimit: 80

# Pointers bind to the type: iowait_t* w
PointerAlignment: Left
DerivePointerAlignment: false

# One argument / parameter per line, broken right after the open bracket.
AlignAfterOpenBracket: AlwaysBreak
BinPackArguments: false
BinPackParameters: false
AllowAllArgumentsOnNextLine: false
AllowAllParametersOfDeclarationOnNextLine: false

# Column alignment used throughout the codebase:
#   - struct members and local declarations (type + name columns)
#   - consecutive assignments (=) and enum initializers
#   - object-like macro bodies
#   - trailing comments
AlignConsecutiveDeclarations: true
AlignConsecutiveAssignments: true
AlignConsecutiveMacros: true
AlignConsecutiveBitFields: true
AlignTrailingComments: true
AlignEscapedNewlines: Left

# Functions always span their own braces; no collapsing onto one line.
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
